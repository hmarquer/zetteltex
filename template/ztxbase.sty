\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ztxbase}

% ztxbase.sty — motor funcional compartido por texnote.cls y texbook.cls.
% No hace falta editar este archivo: los paquetes y el formato se personalizan
% en style.sty (cargado al final de este archivo).

% Matemáticas
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathrsfs}
\RequirePackage{tikz-cd}

% Referencias y enlaces
\RequirePackage{xr-hyper}
\RequirePackage[hypertexnames=false]{hyperref}
\RequirePackage[capitalize,nameinlink,noabbrev]{cleveref}

% Importación de documentos externos (notes/documents.tex)
\RequirePackage{import}

\RequirePackage{slashed}

% Imágenes
\RequirePackage{graphicx}
\graphicspath{{../../resources}}

% Bibliografía
\RequirePackage{biblatex}
\addbibresource{../../bibliography.bib}

\hypersetup{
    colorlinks = false,
    citecolor = cyan
}

% Transclusión de notas
\RequirePackage{catchfilebetweentags}
\RequirePackage{ifthen}

% Personalización del usuario (paquetes y formato)
\usepackage{../../template/style}

% Comandos de referencia
\makeatletter
\newcommand{\ztxhtmlhref}[3]{\href{#1.html\##2}{#3}}
\newcommand{\ztxmaybehyperlink}[2]{%
    \ifx\HCode\UnDeFiNeD
        #1%
    \else
        #2%
    \fi
}

% currentdoc para make4ht
\newcommand\currentdoc[1]{\edef\@currentlabel{#1}\label{#1}}
\ifx\HCode\UnDeFiNeD
% Sin anchors HTML en modo PDF.
\else
\let\ztxoriglabel\label
\newcommand{\ztxhtmlanchor}[1]{\HCode{<a id='}#1\HCode{'></a>}}
\renewcommand{\label}[1]{%
    \ztxoriglabel{#1}%
    \ztxhtmlanchor{#1}%
    \ztxhtmlanchor{\jobname-#1}%
}
\fi
\makeatother