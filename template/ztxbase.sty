\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ztxbase}

% ztxbase.sty — functional engine shared by texnote.cls and texbook.cls.
% Do not edit this file: packages and formatting are customized in
% style.sty (loaded at the end of this file).

% Mathematics
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{amsthm}
\RequirePackage{mathrsfs}
\RequirePackage{tikz-cd}

% References and links
\RequirePackage{xr-hyper}
\RequirePackage[hypertexnames=false]{hyperref}
\RequirePackage[nameinlink,noabbrev]{cleveref}

% Import of external documents (notes/documents.tex)
\RequirePackage{import}

\RequirePackage{slashed}

% Images
\RequirePackage{graphicx}
\graphicspath{{../../resources}}

% Bibliography
\RequirePackage{biblatex}
\addbibresource{../../bibliography.bib}

\hypersetup{
    colorlinks = false,
    citecolor = cyan
}

% Note transclusion
\RequirePackage{catchfilebetweentags}
\RequirePackage{ifthen}

% User customization (packages and formatting)
\usepackage{../../template/style}

% Reference commands
\makeatletter
\newcommand{\ztxhtmlhref}[3]{\href{#1.html\##2}{#3}}
\newcommand{\ztxmaybehyperlink}[2]{%
    \ifx\HCode\UnDeFiNeD
        #1%
    \else
        #2%
    \fi
}

% currentdoc for make4ht
\newcommand\currentdoc[1]{\edef\@currentlabel{#1}\label{#1}}
\ifx\HCode\UnDeFiNeD
% No HTML anchors in PDF mode.
\else
\let\ztxoriglabel\label
\newcommand{\ztxhtmlanchor}[1]{\HCode{<a id='}#1\HCode{'></a>}}
\renewcommand{\label}[1]{%
    \ztxoriglabel{#1}%
    \ztxhtmlanchor{#1}%
    \ztxhtmlanchor{\jobname-#1}%
}
\fi
\makeatother